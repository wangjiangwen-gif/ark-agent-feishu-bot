# 火山方舟 Managed Agents
ARK_API_KEY="your-ark-api-key"
ARK_AGENT_ID="agent-xxxx"
ARK_ENVIRONMENT_ID="env-xxxx"
ARK_VAULT_ID="vlt-xxxx"
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# 飞书应用（由 node-helper/register_app.mjs 扫码创建后写入）
FEISHU_APP_ID="cli_xxxx"
FEISHU_APP_SECRET="xxxx"

# mock 客户A MCP（必须公网可达；static_bearer 创建时会握手探测）
MCP_SERVER_URL="https://your-tunnel.example.com/mcp"

# 网关行为
GATEWAY_DB_PATH="./data/gateway.db"
SESSION_TIMEOUT_MS="600000"
ROLE_TTL_MS="86400000"
# 允许对话的飞书 open_id 白名单（逗号分隔；留空=不限制，交给 MCP 白名单）
AUTHORIZED_OPEN_IDS=""
# 是否为同岗位挂载团队共享 Memory Store（卡点 D-3，可选演示）
TEAM_STORE_ENABLED="false"
