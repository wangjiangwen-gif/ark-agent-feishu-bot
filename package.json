{
  "name": "arkagent",
  "version": "0.2.10-rc.3",
  "description": "Turn a Volcano Ark Managed Agent into a Feishu office assistant with one API key and two QR scans.",
  "type": "module",
  "bin": {
    "arkagent": "dist/cli.js"
  },
  "exports": {
    "./core": {
      "types": "./src/core.ts",
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangjiangwen-gif/ark-agent-feishu-bot.git"
  },
  "homepage": "https://github.com/wangjiangwen-gif/ark-agent-feishu-bot#readme",
  "bugs": {
    "url": "https://github.com/wangjiangwen-gif/ark-agent-feishu-bot/issues"
  },
  "keywords": [
    "volcano-ark",
    "managed-agents",
    "feishu",
    "lark",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "init": "node --experimental-strip-types src/cli.ts init",
    "login": "node --experimental-strip-types src/cli.ts login",
    "start": "node --experimental-strip-types src/cli.ts run",
    "doctor": "node --experimental-strip-types src/cli.ts doctor",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@larksuite/channel": "0.4.1",
    "@larksuiteoapi/node-sdk": "^1.56.0",
    "qrcode-terminal": "^0.12.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
